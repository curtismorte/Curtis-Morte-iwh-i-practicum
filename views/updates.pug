doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Add a Pet
    p.top-link
      a(href="/") Return to the homepage

    .form-wrapper
      form(method="POST" action="/update-cobj")
        label(for="name") Name
        input#name(type="text" name="name" required)

        label(for="breed") Breed
        input#breed(type="text" name="breed" required)

        label(for="age") Age
        input#age(type="text" name="age" required)

        input(type="submit" value="Create record")
