doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Pets (Custom Objects)
    p.top-link
      a(href="/update-cobj") Add to this table

    if notice
      p.notice= notice

    table.records-table
      thead
        tr
          th Name
          th Breed
          th Age
      tbody
        if data && data.length
          each record in data
            tr
              td= record.properties.name || ''
              td= record.properties.breed || ''
              td= record.properties.age || ''
        else
          tr
            td(colspan="3") No records to display yet.
